# EventSignal local configuration.
# Copy to `.env` (never commit it):   cp .env.example .env     (PowerShell: Copy-Item .env.example .env)
# This file holds harmless development defaults only. Do not put real secrets here.
# The backend ignores VITE_* variables; the frontend reads only VITE_* variables.
# Anything prefixed VITE_ is bundled into browser code and is public. Never put API keys in it.

# ---- Backend ----------------------------------------------------------------

# Display name returned by the health endpoint and shown in API docs.
APP_NAME=EventSignal

# Reported by the health endpoint.
APP_VERSION=0.1.0

# One of: development, test, production
APP_ENV=development

# One of: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Address the API binds to when started with `python -m app`.
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Auto-reload on code changes (development only): true or false
BACKEND_RELOAD=false

# Any SQLAlchemy URL. Relative SQLite paths are resolved from the repository root,
# and the containing directory is created on startup.
DATABASE_URL=sqlite:///./data/eventsignal.db

# Comma-separated browser origins allowed to call the API (scheme + host + port, no path, no wildcard).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- Frontend ---------------------------------------------------------------

# Base URL of the backend API as seen by the browser. Required (may be empty).
#   - Direct mode (default): full URL of the backend; relies on CORS_ORIGINS above.
#   - Proxy mode: leave empty; the Vite dev server proxies /api to VITE_PROXY_TARGET.
VITE_API_BASE_URL=http://127.0.0.1:8000

# Dev-server port and proxy target (used by `npm run dev` only).
VITE_DEV_SERVER_PORT=5173
VITE_PROXY_TARGET=http://127.0.0.1:8000

# Client-side request timeout in milliseconds.
VITE_REQUEST_TIMEOUT_MS=8000
